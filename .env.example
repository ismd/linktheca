# Copy this file to `.env` next to compose.prod.yaml on the server and fill it in.
# Docker Compose loads `.env` automatically:
#
#   cp .env.example .env      # then edit the values below
#   docker compose -f compose.prod.yaml pull
#   docker compose -f compose.prod.yaml up -d
#
# `.env` holds secrets — it is gitignored, never commit it.

# ── Required ────────────────────────────────────────────────────────────────

# Password for the Postgres `linktheca` user. It is embedded into the DB
# connection URL, so use a URL-safe value (hex avoids escaping headaches):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# JWT signing secret. Must be at least 32 characters:
#   openssl rand -hex 32
JWT_SECRET=

# ── Image tag ───────────────────────────────────────────────────────────────

# Which published image tag to run (applies to both backend and web).
# Defaults to `latest`. Pin an immutable tag for reproducible deploys,
# e.g. sha-1a2b3c4 or 1.4.0.
#LINKTHECA_TAG=latest

# ── Optional overrides (values shown are the compose.prod.yaml defaults) ─────

# Structured logs are the default in prod. Set to `text` for human-readable.
#LINKTHECA_LOG_FORMAT=json
# debug | info | warn | error
#LINKTHECA_LOG_LEVEL=info

# Set to false to close open sign-ups after creating your account.
#LINKTHECA_REGISTRATION_ENABLED=true

# Access / refresh token lifetimes (Go duration syntax, e.g. 15m, 24h, 720h).
#LINKTHECA_JWT_ACCESS_TTL=15m
#LINKTHECA_JWT_REFRESH_TTL=720h

# Timeout for a single embeddings request to the TEI service.
#LINKTHECA_TEI_TIMEOUT=30s

# Turn the Radar news-monitoring subsystem on/off.
#LINKTHECA_RADAR_ENABLED=true

# How often the crawler polls subscribed feeds, and its worker concurrency.
#LINKTHECA_RADAR_SCHEDULER_INTERVAL=5m
#LINKTHECA_RADAR_MAX_WORKERS=5

# Extra allowed CORS origins (comma-separated). Not needed when the SPA and API
# are served from the same host through the bundled nginx.
#LINKTHECA_CORS_ORIGINS=

# Where downloaded article images are stored (images go to <dir>/images).
# compose.prod.yaml pins this to /data/media, the `linktheca_media` volume that
# nginx also mounts to serve them — don't override it there, or the two sides
# stop pointing at the same directory. Relevant only when running the backend
# outside the bundled compose stack; the binary defaults to ./media.
#LINKTHECA_MEDIA_DIR=/data/media